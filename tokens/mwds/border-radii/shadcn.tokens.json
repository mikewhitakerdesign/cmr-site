{
  "border radii": {
    "rounded-none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$extensions": {
        "com.figma": {
          "scopes": [
            "CORNER_RADIUS"
          ]
        }
      }
    },
    "rounded-xs": {
      "$type": "dimension",
      "$value": "{border radii (absolute).radius-2}",
